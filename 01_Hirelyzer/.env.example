# Copy this file to .env and add your own key. Never commit .env.
OPENROUTER_API_KEY=your-key-here
HIRELYZER_BASE_URL=https://openrouter.ai/api/v1
HIRELYZER_TEXT_MODEL=openai/gpt-oss-20b
HIRELYZER_VISION_MODEL=qwen/qwen3.7-flash
HIRELYZER_TEMPERATURE=0.0
HIRELYZER_MAX_RETRIES=3
HIRELYZER_REPAIR_ATTEMPTS=2
HIRELYZER_MAX_FILE_MB=10
HIRELYZER_MAX_TEXT_CHARS=60000